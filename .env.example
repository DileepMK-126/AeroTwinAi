# ============================================================
# AEROTWIN — Environment Variables Example
# Copy to .env and fill in your values. Never commit .env.
# ============================================================

# --- Application ---
AEROTWIN_ENV=development          # development | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
SECRET_KEY=change-me-in-production
API_HOST=0.0.0.0
API_PORT=8000

# --- MQTT (Eclipse Mosquitto) ---
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false

# --- Storage ---
# SQLite (default)
SQLITE_PATH=./data/aerotwin.db
# PostgreSQL (optional, set DATABASE_URL to switch)
# DATABASE_URL=postgresql://user:pass@localhost:5432/aerotwin

# --- Parquet dataset output ---
DATASET_DIR=./data/datasets

# --- Model Registry ---
MODEL_REGISTRY_DIR=./data/models

# --- Simulation ---
SIM_SEED=42
SIM_DT=1.0                        # simulation timestep in seconds
SIM_REALTIME_FACTOR=600           # how many sim-seconds per real second

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# --- Auth (write endpoints) ---
INGEST_API_KEY=change-me-api-key

# --- Rate limits ---
INGEST_RATE_LIMIT=1000            # requests per minute per IP
